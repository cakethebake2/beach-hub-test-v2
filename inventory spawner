-- Standalone Weapon Spawner for MM2 (with inventory refresh)
local plr = game.Players.LocalPlayer
local rs = game:GetService("ReplicatedStorage")

-- Helper: Get a random mystery box (same as original)
local function getRandomBox()
    local success, boxes = pcall(function()
        return require(rs.Database.Sync.MysteryBox)
    end)
    if not success or not boxes or next(boxes) == nil then
        return "StandardBox"
    end
    local boxNames = {}
    for name in pairs(boxes) do
        table.insert(boxNames, name)
    end
    return boxNames[math.random(#boxNames)]
end

-- Helper: Refresh the inventory GUI
local function refreshInventory()
    -- Try to find the main inventory frame
    local mainGUI = plr.PlayerGui:FindFirstChild("MainGUI")
    if not mainGUI then return end
    
    -- Try to close and reopen the inventory panel
    local inventory = mainGUI:FindFirstChild("Inventory") or mainGUI:FindFirstChild("Game") and mainGUI.Game:FindFirstChild("Inventory")
    if inventory then
        -- If the inventory is visible, toggle it off and on quickly
        if inventory.Visible then
            inventory.Visible = false
            task.wait(0.1)
            inventory.Visible = true
        else
            inventory.Visible = true
            task.wait(0.1)
            inventory.Visible = false
            task.wait(0.1)
            inventory.Visible = true
        end
    else
        -- Fallback: Try to find a toggle button for inventory
        local toggleBtn = mainGUI:FindFirstChild("ToggleInventory") or mainGUI:FindFirstChild("InventoryButton")
        if toggleBtn and toggleBtn:IsA("TextButton") then
            toggleBtn:Activate()
            task.wait(0.2)
            toggleBtn:Activate()
        end
    end
end

-- Spawn function (identical to original vu265)
local function spawnWeapon(weaponName)
    pcall(function()
        local boxModule = require(rs.Modules.BoxModule)
        local itemDB = require(rs.Database.Sync.Item)
        if weaponName and itemDB[weaponName] then
            print("Spawning:", weaponName)
            boxModule.OpenBox(getRandomBox(), weaponName)
            -- Trigger the "New Item" popup (visual)
            pcall(function()
                local newItem = plr.PlayerGui.MainGUI.Inventory.NewItem
                if newItem and newItem._G and newItem._G.NewItem then
                    newItem._G.NewItem(weaponName, nil, nil, "Weapons", 1)
                end
            end)
            -- Refresh inventory to show the new item
            refreshInventory()
            -- Show a notification (using a simple popup if possible)
            print("[✓] Spawned " .. weaponName)
        else
            warn("[✗] Invalid weapon: " .. weaponName)
        end
    end)
end

